# ====== الدخول للوحة التحكم (إلزامي عند النشر) ======
ADMIN_PASSWORD=
# سر عشوائي طويل لتوقيع جلسة الدخول (اختياري لكن مستحسن)
SESSION_SECRET=

# ====== Zoho OAuth (من api-console.zoho.com ← Self Client) ======
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# منطقة الحساب: com | sa | eu | in | com.au | uk | jp | ca | com.cn
# اتركها فارغة وستكتشفها المنصة تلقائياً
ZOHO_DC=

# ====== Zoho Creator (تجدها في صفحة الإعدادات ← الخطوة 3) ======
ZOHO_CREATOR_OWNER=
ZOHO_CREATOR_APP=
ZOHO_CREATOR_UNITS_REPORT=
# اختياري: تجاوز أسماء الحقول بصيغة JSON – انظر src/config/mapping.ts
# ZOHO_CREATOR_FIELD_MAP={"fields":{"code":"Unit_No","status":"Unit_Status"}}

# ====== Zoho Books ======
# اختياري: إذا فارغ نستخدم المنظمة الافتراضية
ZOHO_BOOKS_ORG_ID=
# الحقل الذي يحمل رقم الوحدة في الفاتورة (افتراضياً reference_number)
ZOHO_BOOKS_UNIT_FIELD=reference_number

# ====== عام ======
# mock = إجبار البيانات التجريبية | zoho = إجبار Zoho | فارغ = تلقائي
DATA_MODE=
EXPIRING_WINDOW_DAYS=30
INVOICE_DUE_DAYS=7
ZOHO_CACHE_SECONDS=60
